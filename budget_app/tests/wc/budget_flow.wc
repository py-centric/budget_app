# budget_flow.wc -- Test the budget creation and management flow
# Prerequisites: Flutter web app running at http://localhost:8080
# Run: uv run python __main__.py run tests/wc/budget_flow.wc --headed

strict

goto "http://localhost:8080"
wait for_load_state "domcontentloaded"

# Initial screenshot
screenshot "/tmp/budget_app/budget_flow_01_initial.png"

# Wait a moment for Flutter to fully render
wait for_selector "flt-semantics" , 5000

# Verify the app loaded
verify "flt-semantics" exists

# Take a full page screenshot
screenshot "/tmp/budget_app/budget_flow_02_app_loaded.png" full_page

# Extract all semantic elements to understand the page structure
extract "flt-semantics" as all_elements

# Count semantic elements
let element_count = 0
repeat 1 {
    print "Page has semantic elements"
}

# Try to find budget-related text
# Note: In Flutter web, text is rendered in flt-semantics with aria-label
screenshot "/tmp/budget_app/budget_flow_03_final.png"

if error_count != "0" {
    print "Budget flow errors: " + error_count
} else {
    print "Budget flow test passed"
} endif
