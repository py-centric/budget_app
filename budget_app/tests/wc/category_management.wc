# category_management.wc -- Test category management
# Prerequisites: Flutter web app running at http://localhost:8080
# Run: uv run python __main__.py run tests/wc/category_management.wc --headed

strict

goto "http://localhost:8080"
wait for_load_state "domcontentloaded"

# Wait for Flutter to render
wait for_selector "flt-semantics" , 5000

# Screenshot the initial state
screenshot "/tmp/budget_app/category_01_initial.png"

# Verify app loaded
verify "flt-semantics" exists

# Extract all semantic elements
extract "flt-semantics" as all_elements

# Look for category-related elements
screenshot "/tmp/budget_app/category_02_elements.png"

# Try to find navigation elements
extract "flt-semantics[role='button']" as buttons
if buttons {
    print "Found button elements"
} else {
    print "No button elements found"
} endif

# Final screenshot
screenshot "/tmp/budget_app/category_03_final.png" full_page

if error_count != "0" {
    print "Category management errors: " + error_count
} else {
    print "Category management test passed"
} endif
